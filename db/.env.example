# ============================================================================
# 校园交易平台 —— MySQL 8.0 Docker 环境配置模板
# 用法：复制本文件为 .env，根据本机情况修改端口或密码后执行 docker compose up -d
# ============================================================================

# 监听地址：本机开发默认仅绑定 127.0.0.1；若需局域网联调可改为 0.0.0.0
MYSQL_BIND_HOST=127.0.0.1

# 宿主机映射端口：默认 3306；若本机已安装并运行 MySQL 占用 3306，请改为 3307
MYSQL_PORT=3306

# 数据库名（与建表脚本一致，请勿随意修改）
MYSQL_DATABASE=campus_trading_platform

# 管理员密码（仅用于容器运维、重置库或授权，勿用于后端业务代码）
MYSQL_ROOT_PASSWORD=root_dev_123456

# 后端业务专用账号（仅授予 campus_trading_platform 库权限）
MYSQL_USER=campus_app
MYSQL_PASSWORD=campus_dev_123456

# ----------------------------------------------------------------------------
# 供成员 7（FastAPI 后端）参考的连接串格式（请复制到后端项目 .env）：
# 同步 SQLAlchemy + PyMySQL:
#   DATABASE_URL=mysql+pymysql://campus_app:campus_dev_123456@127.0.0.1:3306/campus_trading_platform?charset=utf8mb4
# 异步 SQLAlchemy + asyncmy:
#   DATABASE_URL=mysql+asyncmy://campus_app:campus_dev_123456@127.0.0.1:3306/campus_trading_platform?charset=utf8mb4
# 异步 SQLAlchemy + aiomysql:
#   DATABASE_URL=mysql+aiomysql://campus_app:campus_dev_123456@127.0.0.1:3306/campus_trading_platform?charset=utf8mb4
# ----------------------------------------------------------------------------
